# ==============================================================
# Variables para docker-compose.yml / Dokploy
# Son build args (no runtime): Vite las incrusta en el bundle al
# compilar, así que un cambio de valor requiere reconstruir la imagen,
# no solo reiniciar el contenedor. Deben definirse en Dokploy como
# variables de entorno de la app; el compose ya las pasa como
# build.args (ver docker-compose.yml).
# ==============================================================

# URL del backend. En el servidor con dominio via Traefik funcionando,
# usa la URL pública real del backend (con /api si el proxy lo agrega
# en producción, según CLAUDE.md del backend). En dev local sin Docker:
# http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Google reCAPTCHA v2 — site key pública usada por el formulario de registro.
# La clave secreta RECAPTCHA_SECRET_KEY pertenece únicamente al backend.
VITE_RECAPTCHA_SITE_KEY=

# Firebase Cloud Messaging (push notifications). Credenciales de
# cliente, seguras para exponer en el bundle — no son secretos de
# servidor. Ver el proyecto de Firebase del equipo para los valores
# reales por ambiente.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_VAPID_KEY=
