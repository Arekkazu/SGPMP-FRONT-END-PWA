# =============================================================================
# SGPMP - Frontend - Ambiente PROD
# =============================================================================
# Plantilla de referencia. Copiar como `.env.prod` y completar los valores.
# `.env.prod` esta ignorado por .gitignore: nunca se versiona.
#
# -----------------------------------------------------------------------------
# ADVERTENCIA 1 - SON BUILD ARGS, NO VARIABLES DE EJECUCION
# -----------------------------------------------------------------------------
# Las nueve variables de este archivo son argumentos de construccion. Vite las
# incrusta literalmente en el bundle al compilar, asi que un cambio de valor
# EXIGE RECONSTRUIR LA IMAGEN. Reiniciar el contenedor no tiene ningun efecto.
#
# Esto tiene tres consecuencias practicas:
#
#   1. La imagen de TEST NO se puede promover a PROD. Lleva horneada la URL de
#      TEST. PROD se construye siempre desde cero.
#   2. Despliegue necesita el dominio definitivo ANTES de construir, no despues.
#   3. Cualquier cambio de dominio posterior obliga a un rebuild completo del
#      frontend, no a un simple redeploy.
#
# -----------------------------------------------------------------------------
# ADVERTENCIA 2 - TODO LO QUE EMPIEZA POR VITE_ TERMINA SIENDO PUBLICO
# -----------------------------------------------------------------------------
# Estas variables quedan visibles, en texto plano, dentro del bundle que
# descarga cualquier navegador. No son un lugar donde esconder nada.
#
# Las claves de cliente de Firebase y la site key de reCAPTCHA estan disenadas
# exactamente para eso y NO son secretos: su seguridad depende de las reglas
# del proyecto Firebase y del dominio autorizado en reCAPTCHA, no de ocultarlas.
#
# Pero NINGUNA CREDENCIAL DE SERVIDOR debe colocarse jamas en una variable
# VITE_. En particular, la clave secreta de reCAPTCHA (RECAPTCHA_SECRET_KEY)
# pertenece unicamente al backend y no tiene ningun equivalente aqui.
# =============================================================================


# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Provee: Despliegue.
# URL HTTPS del backend de PROD, SIN barra final.
# Incluir el prefijo /api si corresponde a la exposicion definitiva detras de
# Traefik. Ejemplo de forma (no es el valor real): https://dominio.tld/api
VITE_API_BASE_URL=


# -----------------------------------------------------------------------------
# Google reCAPTCHA v2
# -----------------------------------------------------------------------------
# Provee: Desarrollo.
# Site key PUBLICA de reCAPTCHA v2, usada por el formulario de registro (RF-01).
# La clave secreta correspondiente es del backend y no va en este archivo.
VITE_RECAPTCHA_SITE_KEY=


# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (notificaciones push)
# -----------------------------------------------------------------------------
# Provee: Desarrollo. Todas son credenciales de CLIENTE de Firebase.
# Las ocho son obligatorias en PROD. Si falta alguna, el bundle compila sin
# error y el contenedor arranca sin error, pero las notificaciones push quedan
# rotas en silencio: no llega ningun aviso de que algo falta.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave publica VAPID del proyecto de Firebase. Sin ella el navegador no puede
# suscribirse a las notificaciones push.
VITE_VAPID_KEY=
