# ============================================================
# SGPMP - Frontend - Ambiente TEST
# ============================================================
# Plantilla de referencia.
# Copiar localmente como .env.test y completar los valores.
# Nunca versionar .env.test.
#
# IMPORTANTE:
# Las variables VITE_* son utilizadas durante el build.
# Un cambio de valor requiere reconstruir la imagen.
# ============================================================

# Backend TEST
# Debe contener la URL HTTPS pública real del Backend TEST.
# Incluir el prefijo /api si corresponde a la exposición definitiva.
VITE_API_BASE_URL=

# Firebase Cloud Messaging
# Estas variables forman parte del bundle del Frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_VAPID_KEY=

# Google reCAPTCHA v2 — site key pública usada por el formulario de registro.
# La clave secreta RECAPTCHA_SECRET_KEY pertenece únicamente al backend.
VITE_RECAPTCHA_SITE_KEY=