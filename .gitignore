# Dependencias
node_modules/
.pnp
.pnp.js

# Build
dist/
dist-ssr/
build/

# Capacitor — plataformas nativas generadas (npx cap add ios/android)
android/
ios/

# Variables de entorno
# Regla general: se ignora cualquier .env.<ambiente> con valores reales y se
# reexcluyen las plantillas .example, que si van versionadas. La doble negacion
# es necesaria porque `.env.*` tambien captura `.env.example`.
.env
.env.*
!.env.example
!.env.*.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cypress
cypress/videos/
cypress/screenshots/
cypress/downloads/

# Vitest / coverage
coverage/
.nyc_output/

# Vite
*.local
vite.config.ts.timestamp-*

# TypeScript
*.tsbuildinfo

# Editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Caché de herramientas
.eslintcache
