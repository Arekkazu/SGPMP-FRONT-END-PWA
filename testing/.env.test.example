# Copia este archivo como testing/.env.test (ignorado por git) y pon las contraseñas reales.
# Los correos son las cuentas reales del ambiente TEST; la contraseña la comparte el equipo,
# no se sube al repositorio.

# Cuenta genérica de los specs antiguos: es la misma del Administrador
TEST_USER_EMAIL=admin.rol@gmail.com
TEST_USER_PASSWORD=<contraseña de TEST>
TEST_ADMIN_EMAIL=admin.rol@gmail.com
TEST_ADMIN_PASSWORD=<contraseña de TEST>

# Cuentas por rol — una por cada perfil de permisos distinto (ver tabla RBAC en CLAUDE.md)
