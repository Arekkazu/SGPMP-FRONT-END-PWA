{
  "info": {
    "_postman_id": "tc-m01-098-notificaciones-id",
    "name": "TC-M01-098 · Notificaciones Orden Descendente API",
    "description": "Colección Newman Postman para verificar el ordenamiento descendente por timestamp (fecha_envio) en GET /notificaciones (CU08 · RF-14)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.environment.set('token', jsonData.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/sesiones/",
          "protocol": "https",
          "host": [
            "sigab-backendtest-389pcb-a48238-158-69-200-27",
            "sslip",
            "io"
          ],
          "path": [
            "api-sgpmp-test",
            "sesiones",
            ""
          ]
        }
      }
    },
    {
      "name": "2. Consultar Notificaciones (GET /notificaciones)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Items array is returned', function () {",
              "    pm.expect(jsonData.items).to.be.an('array');",
              "});",
              "pm.test('Verificar orden estrictamente descendente por fecha_envio (timestamp)', function () {",
              "    var items = jsonData.items;",
              "    if (items.length > 1) {",
              "        for (var i = 0; i < items.length - 1; i++) {",
              "            var tCurrent = new Date(items[i].fecha_envio).getTime();",
              "            var tNext = new Date(items[i + 1].fecha_envio).getTime();",
              "            pm.expect(tCurrent).to.be.at.least(tNext, 'La notificación ' + i + ' (' + items[i].fecha_envio + ') debe ser más reciente o igual a ' + (i+1) + ' (' + items[i+1].fecha_envio + ')');",
              "        }",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/notificaciones?pagina=1&tamano=20",
          "protocol": "https",
          "host": [
            "sigab-backendtest-389pcb-a48238-158-69-200-27",
            "sslip",
            "io"
          ],
          "path": [
            "api-sgpmp-test",
            "notificaciones"
          ],
          "query": [
            { "key": "pagina", "value": "1" },
            { "key": "tamano", "value": "20" }
          ]
        }
      }
    }
  ]
}
