              "pm.test('C3: Descuento de cantidad_actual a 90 y Recálculo de Métricas', function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    var det = jsonData.detalle_poblacional;",
              "    pm.expect(det, 'detalle_poblacional presente').to.exist;",
              "    pm.expect(Number(det.cantidad_actual), 'cantidad_actual descontada a 90').to.eq(90);",
              "    var pesoProm = Number(det.peso_promedio);",
              "    var biomasaCalc = parseFloat(det.biomasa_total);",
              "    pm.expect(biomasaCalc, 'biomasa_total recalculada tras baja (90 * peso)').to.be.closeTo(90 * pesoProm, 0.01);",
              "    if (det.densidad !== null && det.densidad !== undefined) {",
              "        var densCalc = parseFloat(det.densidad);",
              "        pm.expect(densCalc, 'densidad recalculada tras baja (90 / 500 m²)').to.be.closeTo(0.18, 0.001);",
              "    }",
              "});"
