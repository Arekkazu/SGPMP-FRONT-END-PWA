        ],
        "url": {
          "raw": "{{base_url}}/configuracion/ciclos/{{ciclo_id}}/desactivar",
          "host": ["{{base_url}}"],
          "path": ["configuracion", "ciclos", "{{ciclo_id}}", "desactivar"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Teardown Ciclo HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
