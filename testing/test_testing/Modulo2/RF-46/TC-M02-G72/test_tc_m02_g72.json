    {
      "name": "TC-M02-119",
      "item": [
        {
          "name": "119 - Filtrar historial por rango de fechas válido (2024)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Retorna eventos filtrados en el rango\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.total_registros).to.be.above(0);",
                  "    pm.expect(data.registros).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test(\"100% de eventos dentro del rango 2024-01-01 a 2024-12-31\", function () {",
                  "    var data = pm.response.json();",
                  "    var tInicio = new Date('2024-01-01T00:00:00Z').getTime();",
                  "    var tFin = new Date('2024-12-31T23:59:59.999Z').getTime();",
                  "    data.registros.forEach(function(r) {",
                  "        var tEvt = new Date(r.fecha_evento).getTime();",
                  "        pm.expect(tEvt).to.be.at.least(tInicio);",
                  "        pm.expect(tEvt).to.be.at.most(tFin);",
                  "    });",
                  "});",
                  "pm.test(\"Orden cronológico ascendente\", function () {",
                  "    var data = pm.response.json();",
                  "    for (var i = 0; i < data.registros.length - 1; i++) {",
                  "        var tCurrent = new Date(data.registros[i].fecha_evento).getTime();",
                  "        var tNext = new Date(data.registros[i + 1].fecha_evento).getTime();",
                  "        pm.expect(tCurrent).to.be.at.most(tNext);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
