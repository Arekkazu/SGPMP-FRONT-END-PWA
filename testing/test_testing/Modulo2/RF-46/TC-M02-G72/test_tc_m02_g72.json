    {
      "name": "TC-M02-118",
      "item": [
        {
          "name": "118 - Consultar historial completo consolidado (Activo 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Estructura paginada válida\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.id_activo_biologico).to.eql(2);",
                  "    pm.expect(data.total_registros).to.eql(42);",
                  "    pm.expect(data.registros).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test(\"Orden cronológico ascendente por fecha_evento\", function () {",
                  "    var data = pm.response.json();",
                  "    for (var i = 0; i < data.registros.length - 1; i++) {",
                  "        var tCurrent = new Date(data.registros[i].fecha_evento).getTime();",
                  "        var tNext = new Date(data.registros[i + 1].fecha_evento).getTime();",
                  "        pm.expect(tCurrent).to.be.at.most(tNext);",
                  "    }",
                  "});",
                  "pm.test(\"Presencia de múltiples categorías consolidadas\", function () {",
                  "    var data = pm.response.json();",
                  "    var cats = new Set(data.registros.map(function(r) { return r.categoria; }));",
                  "    pm.expect(cats.size).to.be.above(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/2/historial?pagina=1&page_size=50",
              "host": ["{{baseUrl}}"],
              "path": ["activos-biologicos", "2", "historial"],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "50"
                }
              ]
            }
          }
        }
      ]
